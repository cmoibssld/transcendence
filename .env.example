# GitHub OAuth App — create at https://github.com/settings/applications/new
GITHUB_ID=your_github_oauth_app_client_id
GITHUB_SECRET=your_github_oauth_app_client_secret

# Crypto secrets — generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
REFRESH_TOKEN_SECRET=change_me_generate_with_openssl_rand_hex_32
# Must be at least 64 bytes (128 hex chars): openssl rand -hex 64
SESSION_KEY=change_me_generate_with_openssl_rand_hex_64_at_least_128_chars

# OAuth redirect URLs
OAUTH_REDIRECT_URI=https://localhost:8443/auth/github/callback
FRONTEND_REDIRECT_URL=https://localhost:8443/auth/callback

# TLS
COOKIE_SECURE=true

# Internal service auth secret — generate with: openssl rand -hex 32
INTERNAL_SECRET=change_me_generate_with_openssl_rand_hex_32
