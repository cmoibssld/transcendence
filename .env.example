# ─── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → "New OAuth App"
# Homepage URL:            https://localhost:8443
# Authorization callback:  https://localhost:8443/auth/github/callback
GITHUB_ID=
GITHUB_SECRET=

# ─── JWT & Token secrets ──────────────────────────────────────────────────────
# Generate each with:  openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_SECRET=
INTERNAL_SECRET=

# SESSION_KEY must be at least 64 bytes (128 hex chars):
#   openssl rand -hex 64
SESSION_KEY=

# ─── OAuth redirect URLs ──────────────────────────────────────────────────────
OAUTH_REDIRECT_URI=https://localhost:8443/auth/github/callback
FRONTEND_REDIRECT_URL=https://localhost:8443/auth/callback

# ─── Cookie security ──────────────────────────────────────────────────────────
# true  → HTTPS only (default, correct for this setup)
# false → only if serving over plain HTTP
COOKIE_SECURE=true
