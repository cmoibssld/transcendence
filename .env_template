# ─── GitHub OAuth App ────────────────────────────────────────────────────────
GITHUB_ID=GITHUB_ID
GITHUB_SECRET=GITHUB_SECRET

# ─── JWT & Session secrets ───────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
JWT_SECRET=jwt_secret
REFRESH_TOKEN_SECRET=refresh_token_secret
# Must be at least 64 bytes (128 hex chars):
# openssl rand -hex 64
SESSION_KEY=session_key

# ─── OAuth redirect URLs ─────────────────────────────────────────────────────
OAUTH_REDIRECT_URI=https://url/auth/github/callback
FRONTEND_REDIRECT_URL=https://url/auth/callback

COOKIE_SECURE=true
